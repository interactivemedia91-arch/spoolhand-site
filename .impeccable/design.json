      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-chip\">30°</button><button class=\"ds-chip\" aria-pressed=\"true\">45°</button></div>",
      "css": ".ds-chip{min-height:56px;min-width:56px;padding:0 6px;border:1px solid var(--border,#CFC8B6);border-radius:12px;background:var(--surface,#fff);color:var(--ink,#16181B);font:600 1.375rem/1 'Barlow Semi Condensed',system-ui,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer;transition:background-color 140ms ease-out,transform 120ms ease-out}.ds-chip:active{transform:scale(.96)}.ds-chip:focus-visible{outline:2px solid #16181B;outline-offset:2px}.ds-chip[aria-pressed=true]{background:var(--sunken,#EAE5D7);border:2px solid var(--ink,#16181B)}"
