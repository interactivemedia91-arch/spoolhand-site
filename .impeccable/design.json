    {
      "name": "Spec Bar",
      "kind": "custom",
      "refersTo": "spec-bar",
      "description": "Safety-yellow pipe-spec sentence that opens the spec panel.",
      "html": "<button class=\"ds-spec-bar\">6\" · BW LR · gap 1/8\"<svg class=\"ds-chev\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></button>",
      "css": ".ds-spec-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:56px;padding:0 16px;border:0;background:var(--accent,#F2C230);color:var(--on-accent,#16181B);border-radius:12px;font:600 1.375rem/1.15 'Barlow Semi Condensed',system-ui,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer}.ds-spec-bar:focus-visible{outline:2px solid #16181B;outline-offset:2px}.ds-chev{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round;transition:transform 200ms ease-out}.ds-spec-bar:hover .ds-chev{transform:rotate(180deg)}"
    },
    {
      "name": "Result",
      "kind": "custom",
      "refersTo": "result",
      "description": "The answer: the loudest thing on a calculator page; value settles in 220ms.",
      "html": "<div class=\"ds-result\"><span class=\"ds-result-label\">Cut length</span><span class=\"ds-result-value\">26-3/16\"</span></div>",
      "css": ".ds-result{display:flex;flex-direction:column;padding:14px 18px 18px;background:var(--accent,#F2C230);color:var(--on-accent,#16181B);border-radius:12px}.ds-result-label{font:650 1.125rem/1.3 system-ui,sans-serif}.ds-result-value{margin-top:2px;font:700 3.5rem/1 'Barlow Semi Condensed',system-ui,sans-serif;letter-spacing:-0.01em;font-variant-numeric:tabular-nums;animation:ds-settle 220ms cubic-bezier(0.16,1,0.3,1)}@keyframes ds-settle{from{transform:translateY(5px);opacity:.35}}@media (prefers-reduced-motion:reduce){.ds-result-value{animation:none}}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "64px white field: label left, big tabular value right.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Offset</span><input class=\"ds-field-input\" value=\"24\" inputmode=\"decimal\"><span class=\"ds-unit\">\"</span></label>",
      "css": ".ds-field{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;column-gap:10px;min-height:64px;padding:4px 16px;background:var(--surface,#fff);border:1px solid var(--border,#CFC8B6);border-radius:12px}.ds-field:hover{border-color:var(--ink-2,#5F5E57)}.ds-field:focus-within{border-color:var(--ink,#16181B);box-shadow:0 0 0 1px var(--ink,#16181B)}.ds-field-label{color:var(--ink-2,#5F5E57);font-size:1.125rem}.ds-field-input{width:100%;min-width:0;border:0;background:transparent;color:var(--ink,#16181B);font:700 1.875rem/1.1 'Barlow Semi Condensed',system-ui,sans-serif;font-variant-numeric:tabular-nums;text-align:right;outline:none}.ds-unit{font:700 1.875rem/1.1 'Barlow Semi Condensed',system-ui,sans-serif}"
    },
    {
