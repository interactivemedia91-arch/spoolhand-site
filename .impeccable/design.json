  "narrative": {
    "northStar": "The Pocket Handbook",
    "overview": "Every page is a page of the app's pocket handbook, not a software landing page. The system is the app's Blue Book world carried onto the web: warm paper ground, ink text, white cards with a tan outline, a sunken tan panel for worked steps, olive provenance lines under every reference value, and ink line diagrams with dashed dimension lines. On calculator pages the answer is the loudest thing on screen, and it is the only other place the safety yellow appears besides the pipe-spec bar.\n\nDensity is set by gloved thumbs on a phone outdoors: targets are 56px where they are tapped mid-task, 44px minimum everywhere else, numerals are big, condensed and tabular so fractions to 1/16\" line up. The home page persuades (Persuade mode); calculator pages operate (Operate mode). Both share one token set; neither borrows the hero-with-phone-mockup-and-three-feature-cards template.",
    "keyCharacteristics": [
      "Warm paper, ink, and one safety yellow reserved for the spec bar and the result.",
      "Condensed tabular numerals for every number; system-ui for prose.",
      "12px corners on every card-like container; tan hairlines instead of shadows.",
      "Provenance is visual: olive source lines sit under the values they justify.",
      "Ink line diagrams that relabel live as inputs change.",
      "Light, dark, and high-contrast are first-class, driven by the same custom properties."
    ],
    "rules": [
      {
        "name": "The Two Yellows Rule",
        "body": "Safety yellow appears in exactly two places per calculator page: the pipe-spec bar and the result. Selection highlight (::selection) is the only other use. A third yellow surface means the answer is no longer the loudest thing.",
        "section": "colors"
      },
      {
        "name": "The Provenance Color Rule",
        "body": "Olive is reserved for where a value came from. It never colors a heading, a link, or a decoration.",
        "section": "colors"
      },
      {
        "name": "The Every-Number-Is-Barlow Rule",
        "body": "Any measurement, fraction, size or angle is set in the numeral face with tabular figures, including inline numbers in prose (`.num`, `.formula`). Prose words stay in system-ui.",
        "section": "typography"
      },
      {
        "name": "The Stacked Fraction Rule",
        "body": "Angle chips set fractions as superscript/subscript glyph pairs at 0.62em, never as slashed text that wraps.",
        "section": "typography"
      },
      {
        "name": "The Paper-Not-Plastic Rule",
        "body": "Cards sit flat on paper. A drop shadow on a card, chip or result is wrong; use a hairline or a tonal step instead.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep yellow to the spec bar and the result; everything else is paper, white, sunken and ink.",
      "Do set every number in Barlow Semi Condensed with tabular figures.",
      "Do put an olive source line under any reference value that came from a catalog.",
      "Do keep tap targets at 56px for in-task controls (spec bar, chips, store button) and never below 44px.",
      "Do present tool links as one divided white list.",
      "Do show \"Coming soon\" as an outlined label and the live App Store link as an ink button.",
      "Do disable the result settle and all transitions under `prefers-reduced-motion`."
    ],
    "donts": [
      "Don't use the hero-with-phone-mockup-and-three-feature-cards arrangement, or split tool links into three cards.",
