      "css": ".ds-store{display:inline-flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;padding:10px 20px;border-radius:12px;background:var(--ink,#16181B);color:var(--paper,#F4F1E8);text-decoration:none}.ds-store:hover,.ds-store:focus-visible{outline:none;box-shadow:0 0 0 3px var(--paper,#F4F1E8),0 0 0 5px var(--ink,#16181B)}.ds-store-line{font:700 1.25rem/1.1 'Barlow Semi Condensed',system-ui,sans-serif}.ds-store-sub{font-size:.875rem;opacity:.86}"
