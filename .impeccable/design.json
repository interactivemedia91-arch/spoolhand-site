      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-btn is-on\">Angle</button><button class=\"ds-seg-btn\">Run</button></div>",
      "css": ".ds-seg{display:flex;gap:4px;padding:4px;background:var(--sunken,#EAE5D7);border-radius:14px}.ds-seg-btn{flex:1;min-height:48px;padding:0 12px;border:0;border-radius:10px;background:transparent;color:var(--ink,#16181B);font:600 1.0625rem system-ui,sans-serif;cursor:pointer;transition:background-color 160ms ease-out,box-shadow 160ms ease-out}.ds-seg-btn:hover{background:rgb(255 255 255 / .5)}.ds-seg-btn:focus-visible{outline:2px solid #16181B;outline-offset:1px}.ds-seg-btn.is-on{background:var(--segment-on,#fff);box-shadow:0 1px 2px rgb(22 24 27 / .10),0 2px 8px -2px rgb(22 24 27 / .10)}"
