      "css": ".ds-nav{display:flex;gap:4px}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;border-radius:10px;color:var(--ink,#16181B);font-weight:550;text-decoration:none;white-space:nowrap}.ds-nav a:hover{background:var(--sunken,#EAE5D7)}.ds-nav a:focus-visible{outline:2px solid #16181B;outline-offset:2px}.ds-nav a[aria-current=page]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:.35em}"
    }
