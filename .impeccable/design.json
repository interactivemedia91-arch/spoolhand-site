      "refersTo": "tool-row",
      "description": "One divided white list of tools; never three cards.",
      "html": "<ul class=\"ds-tools\"><li><a class=\"ds-tool\" href=\"#\"><span><span class=\"ds-tool-name\">Pipe offset</span><span class=\"ds-tool-line\">Cut length for a two-elbow offset.</span></span><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></svg></a></li><li><a class=\"ds-tool\" href=\"#\"><span><span class=\"ds-tool-name\">Rolling offset</span><span class=\"ds-tool-line\">True offset, travel and roll.</span></span><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></svg></a></li></ul>",
      "css": ".ds-tools{list-style:none;margin:0;padding:0;background:var(--surface,#fff);border-radius:12px;overflow:hidden}.ds-tools li+li{border-top:1px solid var(--border,#CFC8B6)}.ds-tool{display:grid;grid-template-columns:minmax(0,1fr) 20px;align-items:center;gap:18px;min-height:92px;padding:14px 18px;color:var(--ink,#16181B);text-decoration:none}.ds-tool:hover,.ds-tool:focus-visible{background:var(--sunken,#EAE5D7);outline:none}.ds-tool-name{display:block;font:700 1.5rem/1.1 'Barlow Semi Condensed',system-ui,sans-serif}.ds-tool-line{display:block;margin-top:4px;color:var(--ink-2,#5F5E57)}.ds-arrow{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}"
    },
