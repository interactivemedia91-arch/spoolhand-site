      "css": ".ds-store-soon{display:inline-flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;margin:0;padding:10px 20px;border-radius:12px;background:transparent;color:var(--ink,#16181B);box-shadow:inset 0 0 0 1.5px var(--border,#CFC8B6)}.ds-store-soon .ds-store-line{font:700 1.25rem/1.1 'Barlow Semi Condensed',system-ui,sans-serif}.ds-store-soon .ds-store-sub{font-size:.875rem;color:var(--ink-2,#5F5E57)}"
